{
  "name": "e-invoice-desktop",
  "productName": "E-Invoice Desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app for EN 16931 conformant ZUGFeRD/Factur-X invoices (PDF/A-3)",
  "license": "MIT",
  "author": "openrootz",
  "homepage": "https://github.com/OpenRootz/e-invoice-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenRootz/e-invoice-desktop.git"
  },
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "pnpm build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --no-error-on-unmatched-pattern src test \"*.mjs\" \"*.ts\"",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern src test \"*.mjs\" \"*.ts\"",
    "format": "prettier --write --no-error-on-unmatched-pattern src test .github \"*.{json,md,mjs,ts,yml,yaml}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src test .github \"*.{json,md,mjs,ts,yml,yaml}\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdfmake": "~0.3.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
