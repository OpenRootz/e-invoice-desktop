{
  "name": "e-invoice-desktop",
  "productName": "E-Invoice Desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app for EN 16931 conformant ZUGFeRD/Factur-X invoices (PDF/A-3)",
  "license": "MIT",
  "author": "openrootz",
  "homepage": "https://github.com/OpenRootz/e-invoice-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenRootz/e-invoice-desktop.git"
  },
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "pnpm build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts \"*.mjs\" \"*.{ts,mts}\"",
    "lint:fix": "eslint --fix src test scripts \"*.mjs\" \"*.{ts,mts}\"",
    "format": "prettier --write src test scripts .github \"*.{json,md,mjs,mts,ts,yml,yaml}\"",
    "format:check": "prettier --check src test scripts .github \"*.{json,md,mjs,mts,ts,yml,yaml}\"",
    "validate": "bash test/validate/validate.sh"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdfmake": "~0.3.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "i18next": "^27.1.5",
    "lucide-react": "^1.74.0",
    "pdfjs-dist": "~6.5.438",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
